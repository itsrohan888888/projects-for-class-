import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader, Subset
import torchvision
import torchvision.transforms as T
import torchvision.transforms.functional as TF
from sklearn.metrics import accuracy_score, precision_recall_fscore_support, roc_auc_score


class DataWarpingAugmenter:
    def __init__(self, image_size=(32, 32)):
        self.image_size = image_size
        self.geometric = T.Compose([
            T.RandomCrop(32, padding=4),
            T.RandomHorizontalFlip(p=0.5),
            T.RandomRotation(degrees=15)
        ])
        self.color = T.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2)
        self.erasing = T.RandomErasing(p=0.5, scale=(0.02, 0.2), value='random')

    def transform_tensor(self, tensor_img):
        img = self.geometric(tensor_img)
        img = self.color(img)
        img = self.erasing(img)
        return img


class FeatureSpaceAugmenter:
    def add_noise(self, features, noise_level=0.05):
        if not features.requires_grad:
            return features
        noise = torch.randn_like(features) * noise_level
        return features + noise


class ConvFeatureExtractor(nn.Module):
    def __init__(self, num_classes=10):
        super(ConvFeatureExtractor, self).__init__()
        self.features = nn.Sequential(
            nn.Conv2d(3, 32, kernel_size=3, padding=1),
            nn.BatchNorm2d(32),
            nn.ReLU(),
            nn.MaxPool2d(2, 2),
            nn.Conv2d(32, 64, kernel_size=3, padding=1),
            nn.BatchNorm2d(64),
            nn.ReLU(),
            nn.MaxPool2d(2, 2),
            nn.Conv2d(64, 128, kernel_size=3, padding=1),
            nn.BatchNorm2d(128),
            nn.ReLU(),
            nn.AdaptiveAvgPool2d((1, 1))
        )
        self.classifier = nn.Linear(128, num_classes)

    def extract_features(self, x):
        x = self.features(x)
        return torch.flatten(x, 1)

    def forward(self, x):
        feats = self.extract_features(x)
        logits = self.classifier(feats)
        return logits, feats


class EvaluationMetrics:
    @staticmethod
    def compute_classification_metrics(y_true, y_pred, y_prob, num_classes=10):
        accuracy = accuracy_score(y_true, y_pred)
        precision, recall, f1, _ = precision_recall_fscore_support(y_true, y_pred, average='macro', zero_division=0)
        
        y_true_onehot = np.eye(num_classes)[y_true]
        try:
            auc_roc = roc_auc_score(y_true_onehot, y_prob, multi_class='ovr', average='macro')
        except ValueError:
            auc_roc = 0.0

        return {
            'Accuracy': accuracy,
            'Precision': precision,
            'Recall': recall,
            'F1-Score': f1,
            'AUC-ROC': auc_roc
        }


def get_dataloaders(batch_size=64, samples_per_class=200):
    transform = T.ToTensor()
    full_train = torchvision.datasets.CIFAR10(root='./data', train=True, download=True, transform=transform)
    test_dataset = torchvision.datasets.CIFAR10(root='./data', train=False, download=True, transform=transform)

    targets = np.array(full_train.targets)
    indices = []
    for c in range(10):
        cls_indices = np.where(targets == c)[0][:samples_per_class]
        indices.extend(cls_indices)

    train_subset = Subset(full_train, indices)
    
    train_loader = DataLoader(train_subset, batch_size=batch_size, shuffle=True)
    test_loader = DataLoader(test_dataset, batch_size=batch_size, shuffle=False)
    
    return train_loader, test_loader


def train_model(use_augmentation=False, epochs=15, device='cpu'):
    train_loader, test_loader = get_dataloaders()
    model = ConvFeatureExtractor(num_classes=10).to(device)
    criterion = nn.CrossEntropyLoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
    
    warper = DataWarpingAugmenter()
    feature_augmenter = FeatureSpaceAugmenter()

    model.train()
    for epoch in range(epochs):
        for images, labels in train_loader:
            images, labels = images.to(device), labels.to(device)
            optimizer.zero_grad()

            if use_augmentation:
                augmented_images = torch.stack([warper.transform_tensor(img) for img in images])
                logits, features = model(augmented_images)
                
                aug_features = feature_augmenter.add_noise(features)
                aug_logits = model.classifier(aug_features)
                
                loss = criterion(logits, labels) + criterion(aug_logits, labels)
            else:
                logits, _ = model(images)
                loss = criterion(logits, labels)

            loss.backward()
            optimizer.step()

    model.eval()
    all_preds, all_probs, all_targets = [], [], []

    with torch.no_grad():
        for images, labels in test_loader:
            images = images.to(device)
            logits, _ = model(images)
            probs = F.softmax(logits, dim=1)
            preds = torch.argmax(probs, dim=1)

            all_preds.extend(preds.cpu().numpy())
            all_probs.extend(probs.cpu().numpy())
            all_targets.extend(labels.numpy())

    metrics = EvaluationMetrics.compute_classification_metrics(
        np.array(all_targets),
        np.array(all_preds),
        np.array(all_probs),
        num_classes=10
    )
    return metrics


if __name__ == "__main__":
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    
    print("Training Baseline Model (Without Data Augmentation)...")
    baseline_metrics = train_model(use_augmentation=False, epochs=15, device=device)

    print("\nTraining Augmented Model (With Data Warping & Feature Space Augmentation)...")
    augmented_metrics = train_model(use_augmentation=True, epochs=15, device=device)

    print("\n" + "="*50)
    print(f"{'Metric':<15} | {'Without Augmentation':<20} | {'With Augmentation':<20}")
    print("="*50)
    for k in baseline_metrics.keys():
        print(f"{k:<15} | {baseline_metrics[k]:<20.4f} | {augmented_metrics[k]:<20.4f}")
    print("="*50)
